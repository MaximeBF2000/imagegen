{
  "name": "imagegen",
  "private": true,
  "version": "0.1.0",
  "description": "AI image generation & editing studio (Next.js + NestJS + local FLUX.2 / FLUX 3 / Qwen-Image via diffusers)",
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r --parallel --stream run start",
    "inference": "pnpm --filter inference dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter api run build && pnpm --filter api run test",
    "setup:model": "pnpm --filter inference run setup",
    "docker:agent:install": "./scripts/install-inference-agent.sh",
    "docker:agent:uninstall": "./scripts/install-inference-agent.sh --uninstall",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:update": "docker compose down && docker compose build && docker compose up -d",
    "docker:logs": "tail -f ~/Library/Logs/imagegen/supervisor.log ~/Library/Logs/imagegen/inference.log",
    "setup:flux": "pnpm --filter inference run setup:flux",
    "setup:qwen": "pnpm --filter inference run setup:qwen",
    "setup:flux3": "pnpm --filter inference run setup:flux3",
    "setup:upscale": "pnpm --filter inference run setup:upscale",
    "setup:loras": "pnpm --filter inference run setup:loras",
    "setup:qwen-base": "pnpm --filter inference run setup:qwen-base"
  },
  "packageManager": "pnpm@9.8.0",
  "engines": {
    "node": ">=22.13"
  }
}
