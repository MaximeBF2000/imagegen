# ─────────────────────────────────────────────────────────────
#  Imagegen Studio configuration
#  The only required value is OPENROUTER_API_KEY.
# ─────────────────────────────────────────────────────────────

# Your OpenRouter key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# ── Image model ──────────────────────────────────────────────
# Provider implementation: openrouter | mock (offline fake images for dev)
IMAGE_PROVIDER=openrouter
IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# Any server implementing OpenRouter's /images contract can be used here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Prompt enhancer LLM ─────────────────────────────────────
# Provider implementation: openai-compatible | mock
TEXT_PROVIDER=openai-compatible
TEXT_MODEL=google/gemini-3.5-flash-lite
# Any OpenAI-compatible endpoint (OpenRouter, Ollama http://localhost:11434/v1, LM Studio...)
TEXT_BASE_URL=https://openrouter.ai/api/v1
# Defaults to OPENROUTER_API_KEY when empty
TEXT_API_KEY=

# ── Queue ────────────────────────────────────────────────────
QUEUE_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3

# ── Server ──────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=*
# Optional: protect the API with a bearer token (also set NEXT_PUBLIC_API_TOKEN for the web app)
API_TOKEN=
DATA_DIR=data

# ── Web app ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_TOKEN=
