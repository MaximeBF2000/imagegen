# ─────────────────────────────────────────────────────────────
#  Imagegen Studio configuration (everything runs locally)
#  No value is required: the defaults below work out of the box.
# ─────────────────────────────────────────────────────────────

# ── Image model (apps/inference, Hugging Face diffusers) ────
# Provider implementation: local | mock (offline fake images for dev)
IMAGE_PROVIDER=local
# Default image model, switchable per generation in the UI (header) or with "model" in the API:
#   flux2-klein-4b        FLUX.2 [klein] 4B (bf16, ~16 GB)        pnpm setup:flux
#   qwen-image-2.1-turbo  Qwen-Image 2.1 Turbo, Q8 GGUF (~17 GB)   pnpm setup:qwen
# Weights live in the default HF cache (~/.cache/huggingface/hub, or $HF_HOME). One model is
# kept in memory at a time; picking the other one swaps it (takes a few seconds to a minute).
IMAGE_MODEL=flux2-klein-4b
# FLUX.2 klein only (Qwen uses its checkpoint's 8-step Turbo schedule):
# 4 steps / guidance 1.0 is what the distilled klein model is tuned for
INFERENCE_STEPS=4
INFERENCE_GUIDANCE=1.0
INFERENCE_PORT=8000
# Force a device (mps | cuda | cpu); auto-detected when empty
INFERENCE_DEVICE=

# ── Prompt enhancer LLM ─────────────────────────────────────
# local: reuses FLUX.2 klein's own Qwen3 text encoder (no extra download, text only)
# openai-compatible: any OpenAI-style server, e.g. Ollama with a vision model that can see references
TEXT_PROVIDER=local
TEXT_BASE_URL=http://localhost:11434/v1
TEXT_MODEL=qwen3-vl:8b
TEXT_API_KEY=

# ── Queue ────────────────────────────────────────────────────
QUEUE_CONCURRENCY=1
QUEUE_MAX_ATTEMPTS=3

# ── Server ──────────────────────────────────────────────────
API_PORT=4310
API_PUBLIC_URL=http://localhost:4310
CORS_ORIGINS=*
# Optional: protect the API with a bearer token (also set NEXT_PUBLIC_API_TOKEN for the web app)
API_TOKEN=
DATA_DIR=data

# ── Web app ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4310
NEXT_PUBLIC_API_TOKEN=
