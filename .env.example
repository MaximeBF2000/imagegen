# ─────────────────────────────────────────────────────────────
#  Imagegen Studio configuration (everything runs locally)
#  No value is required: the defaults below work out of the box.
# ─────────────────────────────────────────────────────────────

# ── Image model (apps/inference, Hugging Face diffusers) ────
# Provider implementation: local | mock (offline fake images for dev)
IMAGE_PROVIDER=local
# Default image model, switchable per generation in the UI (header) or with "model" in the API:
#   flux2-klein-4b        FLUX.2 [klein] 4B (bf16, ~16 GB)        pnpm setup:flux
#   qwen-image-2.1-turbo  Qwen-Image 2.1 Turbo, Q8 GGUF (~17 GB)   pnpm setup:qwen
#   qwen-image-2.1        Qwen-Image 2.1 base, Q8 GGUF (+7.6 GB)   pnpm setup:qwen-base
#   flux3-klein           FLUX 3 Image klein, Q8 GGUF (~10.5 GB)   pnpm setup:flux3
# Weights live in the default HF cache (~/.cache/huggingface/hub, or $HF_HOME). One model is
# kept in memory at a time; picking the other one swaps it (takes a few seconds to a minute).
IMAGE_MODEL=qwen-image-2.1-turbo
# FLUX.2 klein only (Qwen uses its checkpoint's 8-step Turbo schedule, FLUX 3 klein FLUX3_STEPS=16):
# 4 steps / guidance 1.0 is what the distilled klein model is tuned for
INFERENCE_STEPS=4
INFERENCE_GUIDANCE=1.0
# Qwen-Image 2.1 base (non-Turbo) steps (diffusers' default is 40; LoRA authors mostly use 20-30)
QWEN_BASE_STEPS=30
INFERENCE_PORT=8000
# Force a device (mps | cuda | cpu); auto-detected when empty
INFERENCE_DEVICE=

# ── LoRAs ────────────────────────────────────────────────────
# Optional style adapters, picked per generation in the UI (LoRA button next to the folder
# picker; only shown for models that have some). Catalog: apps/api/src/providers/loras.ts
# + apps/inference/loras.py. Download them once with `pnpm setup:loras`.
# Where LoRA files are stored (default: $HF_HOME/loras = ~/.cache/huggingface/loras)
LORA_DIR=
# Civitai API key, needed to download LoRAs hosted there (civitai.com → Account settings → API Keys).
# Only sent to civitai.com, only by `pnpm setup:loras`.
CIVITAI_TOKEN=

# ── Upscaling ────────────────────────────────────────────────
# Default upscaler (apps/inference/upscalers.py), picked per image in the UI:
#   seedvr2-7b-8bit  SeedVR2 7B, 8-bit MLX (~9 GB, Apple Silicon)  pnpm setup:upscale
UPSCALER=seedvr2-7b-8bit
# Path to the mlx-gen CLI when it isn't on PATH or in ~/.local/bin
MLXGEN_BIN=
# Results larger than this (px per side) are upscaled in overlapping tiles and blended.
# SeedVR2 7B peaks at ~40 GB up to ~1536 px and 66 GB at 2048 px; lower it on smaller Macs.
UPSCALE_TILE=1536
UPSCALE_TILE_OVERLAP=128

# ── Prompt enhancer LLM ─────────────────────────────────────
# local: reuses FLUX.2 klein's own Qwen3 text encoder (no extra download, text only)
# openai-compatible: any OpenAI-style server, e.g. Ollama with a vision model that can see references
TEXT_PROVIDER=local
TEXT_BASE_URL=http://localhost:11434/v1
TEXT_MODEL=qwen3-vl:8b
TEXT_API_KEY=

# ── Queue ────────────────────────────────────────────────────
QUEUE_CONCURRENCY=1
QUEUE_MAX_ATTEMPTS=3

# ── Server ──────────────────────────────────────────────────
API_PORT=4310
API_PUBLIC_URL=http://localhost:4310
CORS_ORIGINS=*
# Optional: protect the API with a bearer token (also set NEXT_PUBLIC_API_TOKEN for the web app)
API_TOKEN=
DATA_DIR=data

# ── Web app ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4310
NEXT_PUBLIC_API_TOKEN=
